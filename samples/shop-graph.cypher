UNWIND [{`src`: "shop|Table:customers", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:1:db-unique:customers.email must be unique", `props`: {}}, {`src`: "shop|Table:customers", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:1:db-check:customers.credit_limit must satisfy: cre", `props`: {}}, {`src`: "shop|Table:orders", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:8:db-check:orders must satisfy: status IN ('NEW','P", `props`: {}}, {`src`: "shop|Table:order_lines", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:17:db-check:order_lines.quantity must satisfy: quant", `props`: {}}, {`src`: "shop|Table:stock_items", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:25:db-check:stock_items.available_qty must satisfy: ", `props`: {}}, {`src`: "shop|Table:orders", `dst`: "shop|BusinessRule:db/migration/V1__init.sql:39:db-trigger:Trigger trg_order_status on orders (afte", `props`: {}}] AS row MATCH (a:`Table` {uid: row.src}) MATCH (b:`BusinessRule` {uid: row.dst}) MERGE (a)-[x:`EXECUTES`]->(b) SET x += row.props;
UNWIND [{`src`: "shop|Table:customers", `dst`: "shop|Capability:customers", `props`: {}}, {`src`: "shop|Table:customers", `dst`: "shop|Capability:orders", `props`: {}}, {`src`: "shop|Table:orders", `dst`: "shop|Capability:orders", `props`: {}}, {`src`: "shop|Table:order_audit", `dst`: "shop|Capability:orders", `props`: {}}, {`src`: "shop|Table:stock_items", `dst`: "shop|Capability:inventory", `props`: {}}] AS row MATCH (a:`Table` {uid: row.src}) MATCH (b:`Capability` {uid: row.dst}) MERGE (a)-[x:`IMPLEMENTS`]->(b) SET x += row.props;
UNWIND [{`src`: "shop|Topic:orders.created", `dst`: "shop|Service:com.acme.shop.inventory.OrderEventsListener", `props`: {`method`: ["onOrderCreated"], `kind`: "consume"}}] AS row MATCH (a:`Topic` {uid: row.src}) MATCH (b:`Service` {uid: row.dst}) MERGE (a)-[x:`CALLS`]->(b) SET x += row.props;
UNWIND [{`src`: "shop|Topic:orders.created", `dst`: "shop|Capability:orders", `props`: {}}, {`src`: "shop|Topic:orders.created", `dst`: "shop|Capability:inventory", `props`: {}}] AS row MATCH (a:`Topic` {uid: row.src}) MATCH (b:`Capability` {uid: row.dst}) MERGE (a)-[x:`IMPLEMENTS`]->(b) SET x += row.props;

// ---- Example queries -------------------------------------------------------------------------------------
// Everything a screen reaches, down to the tables (the call chain of the ontology):
//   MATCH p = (s:Screen {name: 'OrderCreateComponent'})-[*1..6]->(t:Table) RETURN p
// Impact: what depends on a table (walk the arrows backwards):
//   MATCH p = (x)-[:CALLS|USES|READS|WRITES|EXECUTES|DEPENDS_ON*1..6]->(t:Table {name: 'customers'}) RETURN p
// Who writes a table, and through which repository method:
//   MATCH (s)-[w:WRITES]->(t:Table {name: 'orders'}) RETURN s.type, s.name, w.via
// Business rules, most worrying first:
//   MATCH (r:BusinessRule) WHERE r.suspected_defect IS NOT NULL RETURN r.rule_id, r.name, r.priority ORDER BY r.priority
// The ontology as found in the data (which relations exist between which types):
//   MATCH (a)-[r]->(b) RETURN labels(a)[0] AS from, type(r) AS rel, labels(b)[0] AS to, count(*) AS n ORDER BY n DESC
